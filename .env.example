# Copie para .env: cp .env.example .env
# Roles Postgres: npac_owner (dono/migrations) e npac_app (runtime, sujeita a RLS)
DATABASE_URL=postgresql://npac_owner:CHANGE_ME_OWNER@localhost:5432/npac
APP_DATABASE_URL=postgresql://npac_app:CHANGE_ME_APP@localhost:5432/npac
# Usado pelos testes; suites derivam nomes de banco a partir desta URL
TEST_DATABASE_URL=postgresql://npac_owner:CHANGE_ME_OWNER@localhost:5432/npac_test

# Senhas lidas pelo docker compose (devem casar com as URLs acima)
OWNER_DB_PASSWORD=CHANGE_ME_OWNER
APP_DB_PASSWORD=CHANGE_ME_APP

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# base64 de 32 bytes. Gere com: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=CHANGE_ME
# base64 de 32 bytes. Gere com: openssl rand -base64 32
BLIND_INDEX_KEY=CHANGE_ME

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Senha inicial do seed (≥ 12 caracteres). Cada pessoa troca no primeiro login.
SEED_INITIAL_PASSWORD=troque-esta-senha-inicial

# true quando a API roda atrás de proxy (Caddy) para o IP real vir do X-Forwarded-For
TRUST_PROXY=false

# Origens extras aceitas no login, separadas por vírgula (ex.: túnel de teste). Vazio em produção.
EXTRA_TRUSTED_ORIGINS=
