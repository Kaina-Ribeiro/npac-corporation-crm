# Produção: cp .env.prod.example .env.prod (fora do git) e preencha. Nunca reutilize as chaves de dev.
DOMAIN=crm.exemplo.com.br
ACME_EMAIL=ti@exemplo.com.br

# openssl rand -hex 24 (sem caracteres especiais: entram em URLs)
OWNER_DB_PASSWORD=CHANGE_ME
APP_DB_PASSWORD=CHANGE_ME

# openssl rand -base64 32 — guarde FIELD_ENCRYPTION_KEY e BLIND_INDEX_KEY no cofre:
# sem elas os telefones cifrados (e os backups) ficam ilegíveis.
BETTER_AUTH_SECRET=CHANGE_ME
FIELD_ENCRYPTION_KEY=CHANGE_ME
BLIND_INDEX_KEY=CHANGE_ME

# Senha inicial do seed (≥ 12 caracteres); cada pessoa troca no primeiro login.
SEED_INITIAL_PASSWORD=CHANGE_ME

# Imagens (registry do OCI ou build local) e backups
REGISTRY=npac
TAG=latest
BACKUP_DIR=/srv/npac/backups
BACKUP_KEEP_DAYS=14
