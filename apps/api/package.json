{
  "name": "@npac/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "import:firebase": "node --env-file-if-exists=../../.env dist/import/cli.js",
    "mock:prototype": "tsc -p tsconfig.build.json && node --env-file-if-exists=../../.env dist/dev/mock-prototype.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-fastify": "^11.2.8",
    "@node-rs/argon2": "^2.2.2",
    "@npac/db": "workspace:*",
    "@npac/shared": "workspace:*",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.20",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "fastify": "5.12.7",
    "otpauth": "^9.5.2",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
