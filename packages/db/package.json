{
  "name": "@npac/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate",
    "seed": "node --env-file-if-exists=../../.env dist/seed-cli.js",
    "migrate": "node --env-file-if-exists=../../.env dist/migrate-cli.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@npac/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.0",
    "vitest": "^5.0.5"
  }
}
