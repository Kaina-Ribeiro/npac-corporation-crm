{
  "name": "@npac/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./enums": {
      "types": "./dist/enums.d.ts",
      "default": "./dist/enums.js"
    },
    "./cargos": {
      "types": "./dist/cargos.d.ts",
      "default": "./dist/cargos.js"
    },
    "./mentoria": {
      "types": "./dist/mentoria/index.d.ts",
      "default": "./dist/mentoria/index.js"
    },
    "./permissions": {
      "types": "./dist/permissions.d.ts",
      "default": "./dist/permissions.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "default": "./dist/money.js"
    },
    "./reminders": {
      "types": "./dist/reminders.d.ts",
      "default": "./dist/reminders.js"
    },
    "./screen-prefs": {
      "types": "./dist/screen-prefs.d.ts",
      "default": "./dist/screen-prefs.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@date-fns/tz": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
